# Copy to .env and fill in. Secrets and deploy-specific values only.
DISCORD_TOKEN=          # bot token from the Discord developer portal
DISCORD_CLIENT_ID=      # application ID, needed only by npm run deploy-commands
FANTASY_AGENT_URL=http://localhost:8787   # base URL of the fantasy-bot API
# Settings and per-guild config live in src/config/ (default.js + prod.js / test.js, chosen by APP_ENV)
APP_ENV=test   # prod or test: picks src/config/prod.js or test.js
